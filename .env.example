# ===========================================
# MediBot Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env file to version control!
# ===========================================

# -------------------------------------------
# Application Settings
# -------------------------------------------
APP_NAME=MediBot
APP_ENV=development
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production

# -------------------------------------------
# Database Configuration (Supabase/PostgreSQL)
# -------------------------------------------
# For Supabase (Production):
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# For Local Docker (Development):
# DATABASE_URL=postgresql://medibot_user:MediBot123@127.0.0.1:5433/medibot

# -------------------------------------------
# Redis Configuration
# -------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------
# JWT Authentication
# -------------------------------------------
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------
# Frontend Configuration
# -------------------------------------------
FRONTEND_URL=http://localhost:3000
FRONTEND_CALLBACK_URL=http://localhost:3000/callback

# -------------------------------------------
# Backend Configuration
# -------------------------------------------
BACKEND_URL=http://localhost:8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# -------------------------------------------
# CORS Settings
# -------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True

# -------------------------------------------
# NLP Model Settings
# -------------------------------------------
NLP_MODEL_PATH=nlp_models/models/
NLP_MODEL_NAME=bert-base-uncased
SYMPTOM_EXTRACTION_THRESHOLD=0.75
DISEASE_PREDICTION_THRESHOLD=0.65

# -------------------------------------------
# Voice Input Settings
# -------------------------------------------
VOICE_INPUT_ENABLED=True
WHISPER_MODEL=base
AUDIO_MAX_DURATION=60

# -------------------------------------------
# Email Configuration (SMTP)
# -------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@medibot.com
SMTP_TLS=True

# -------------------------------------------
# Notification Settings
# -------------------------------------------
ENABLE_EMAIL_NOTIFICATIONS=False
ENABLE_SMS_NOTIFICATIONS=False

# -------------------------------------------
# Security Settings
# -------------------------------------------
RATE_LIMIT_PER_MINUTE=100
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_SPECIAL=True
PASSWORD_REQUIRE_NUMBER=True
PASSWORD_REQUIRE_UPPERCASE=True

# -------------------------------------------
# File Upload Settings
# -------------------------------------------
UPLOAD_FOLDER=uploads/
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=png,jpg,jpeg,pdf

# -------------------------------------------
# Logging Configuration
# -------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/medibot.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# -------------------------------------------
# Cache Settings
# -------------------------------------------
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=300
CACHE_REDIS_URL=redis://localhost:6379/1

# -------------------------------------------
# API Keys (Third-party services)
# -------------------------------------------
# OpenAI API (Optional - for advanced features)
OPENAI_API_KEY=
USE_OPENAI=False

# Google Cloud Speech (Optional)
GOOGLE_CLOUD_PROJECT=
GOOGLE_SPEECH_API_KEY=

# AWS S3 (Optional - for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_REGION=us-east-1

# -------------------------------------------
# Deployment Settings
# -------------------------------------------
DEPLOYMENT_ENV=local
DOCKER_COMPOSE_PROJECT_NAME=medibot
NGINX_PORT=80
NGINX_SSL_PORT=443

# -------------------------------------------
# SSL/TLS Settings (Production)
# -------------------------------------------
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem
USE_SSL=False

# -------------------------------------------
# Monitoring & Analytics
# -------------------------------------------
ENABLE_SENTRY=False
SENTRY_DSN=
ENABLE_ANALYTICS=True

# -------------------------------------------
# Feature Flags
# -------------------------------------------
ENABLE_VOICE_INPUT=True
ENABLE_MULTI_LANGUAGE=True
ENABLE_ADMIN_PANEL=True
ENABLE_HEALTH_DASHBOARD=True
ENABLE_PWA=True
ENABLE_DARK_MODE=True

# -------------------------------------------
# Localization
# -------------------------------------------
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ur
DEFAULT_TIMEZONE=Asia/Karachi

# -------------------------------------------
# Database Pool Settings
# -------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# -------------------------------------------
# Session Settings
# -------------------------------------------
SESSION_TYPE=redis
SESSION_PERMANENT=True
SESSION_USE_SIGNER=True
SESSION_TIMEOUT_MINUTES=60
